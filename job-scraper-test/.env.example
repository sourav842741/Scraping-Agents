# Webshare — get API key from https://proxy.webshare.io/
# Free tier gives 10 proxies. The app fetches proxy list via API.
# Docs: https://proxy.webshare.io/api/v2/

WEBSHARE_API_KEY=your_api_key_here

# Optional: filter proxies by country code (ISO 2-letter, e.g. US, IN, GB)
# WEBSHARE_PROXY_COUNTRY=us

# Production (KloudBean / VPS)
NODE_ENV=production
HOST=0.0.0.0

# API port (default 3847). Workspace ports — job-scraper 3847, google-search 3848, download 3939, hr-finding 3940, maps 3942
PORT=3847
