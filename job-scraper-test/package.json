{
  "name": "job-scraper-test",
  "version": "0.2.0",
  "private": true,
  "description": "Research-only Puppeteer job extraction with live dashboard",
  "type": "module",
  "scripts": {
    "test": "node src/run-tests.js",
    "test:linkedin": "node src/run-tests.js --site linkedin",
    "test:indeed": "node src/run-tests.js --site indeed",
    "server": "node server/index.js",
    "dashboard:dev": "vite --config dashboard/vite.config.js",
    "dev": "concurrently -k -n api,ui -c cyan,magenta \"npm run server\" \"npm run dashboard:dev\"",
    "build:dashboard": "vite build --config dashboard/vite.config.js",
    "start": "npm run build:dashboard && node server/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "puppeteer": "^24.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.3"
  }
}
